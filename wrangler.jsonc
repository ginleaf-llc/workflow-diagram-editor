{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workflow-diagram-editor",
  "compatibility_date": "2026-09-10",
  "pages_build_output_dir": ".",
  "kv_namespaces": [
    {
      // wrangler kv namespace create 実行後にIDを埋める
      "binding": "WORKFLOW_KV",
      "id": "REPLACE_WITH_REAL_KV_ID"
    }
  ]
}
